# Copy this file to `.env` and fill it in. DCS Code CLI loads `.env` from the
# current directory automatically, so you do NOT need to `source` it — just run
# `dcs-code`. (The `export` keywords also make `source .env` work if you prefer.)
# Real environment variables always take precedence over this file.

# --- LiteLLM (LLM backend) --------------------------------------------------
# The shared HTTPS endpoint of your LiteLLM proxy and YOUR per-user API key.
export LITELLM_BASE_URL=https://litellm.example.com
export LITELLM_API_KEY=sk-...

# Optional: default model. Otherwise pick one at runtime with /model, or the
# first model the proxy reports is used.
# export LITELLM_MODEL=gpt-4o

# (AICODER_BASE_URL / AICODER_API_KEY and OPENAI_BASE_URL / OPENAI_API_KEY are
#  accepted as fallbacks if the LITELLM_* variables are unset.)

# --- GitLab (on-prem issue tracking) ---------------------------------------
# Base URL of your GitLab instance and a personal access token with `api` scope.
export GITLAB_URL=https://gitlab.example.com
export GITLAB_TOKEN=glpat-...

# Optional default project (numeric id or "group/subgroup/project"). If unset,
# the project is auto-detected from the git 'origin' remote of the directory you
# run `dcs-code` in; you can also pass it explicitly to each command/tool.
# export GITLAB_PROJECT=my-group/my-project

# --- Corporate TLS / Zscaler ------------------------------------------------
# If you're behind a TLS-inspecting proxy (Zscaler, etc.), pick ONE:
#
# 1) Point at a CA bundle / root cert (PEM). REQUESTS_CA_BUNDLE / SSL_CERT_FILE
#    are also honored as fallbacks.
# export AICODER_CA_BUNDLE=/etc/ssl/certs/zscaler-root.pem
#
# 2) Or trust the OS certificate store (where IT usually installs the Zscaler
#    cert). Requires: pip install truststore
# export AICODER_SYSTEM_CERTS=1
